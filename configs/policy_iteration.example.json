{
  "iteration_id": "iteration-001",
  "base_policy": "policy-v001",
  "training_dataset": "../iteration_datasets/iteration-001",
  "evaluation_dataset": "../evaluation_data/held_out_tasks",
  "output_dir": "../policy_iteration_outputs/iteration-001",
  "deployment_target": "lab-robot",
  "approval_file": "./policy_iteration.approval.example.json",
  "plugins": {
    "trainer": {
      "spec": "policy_backends.command_trainer:create_trainer",
      "init": {
        "command": [
          "python", "-m", "lerobot.scripts.train",
          "--dataset.repo_id={training_dataset}",
          "--policy.type=act",
          "--output_dir={output_dir}",
          "--steps={steps}"
        ],
        "checkpoint": "{output_dir}/checkpoints/last/pretrained_model"
      },
      "request": {
        "steps": 20000
      }
    },
    "evaluator": {
      "spec": "policy_backends.offline_evaluator:create_evaluator",
      "init": {
        "pass_threshold": 0.9,
        "evaluator_config": {"device": "cuda", "anchors": 6, "eval_horizon": 10},
        "extra_metrics": {"intervention_rate": 0.1, "critical_failures": 0}
      },
      "request": {}
    },
    "deployer": {
      "spec": "policy_backends.filesystem_deployer:create_deployer",
      "init": {
        "target_root": "../deployments"
      },
      "request": {}
    }
  },
  "promotion": {
    "min_success_rate": 0.8,
    "max_intervention_rate": 0.2,
    "max_critical_failures": 0,
    "baseline_success_rate": 0.72,
    "min_success_rate_delta": 0.03,
    "require_human_approval": true
  }
}
